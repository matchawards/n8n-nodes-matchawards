{
  "name": "n8n-nodes-matchawards",
  "version": "0.1.0",
  "description": "n8n node for MatchAwards: search US federal and state contract opportunities, grants and jobs.",
  "keywords": ["n8n-community-node-package", "matchawards", "government contracts", "grants", "naics"],
  "license": "MIT",
  "homepage": "https://github.com/matchawards/n8n-nodes-matchawards",
  "author": {"name": "MatchAwards"},
  "repository": {"type": "git", "url": "git+https://github.com/matchawards/n8n-nodes-matchawards.git"},
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node -e \"require('fs').copyFileSync('nodes/MatchAwards/matchawards.svg','dist/nodes/MatchAwards/matchawards.svg')\"",
    "test": "npm run build && node --test \"test/*.test.js\"",
    "smoke": "npm run build && node test/smoke.js"
  },
  "files": ["dist"],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [],
    "nodes": ["dist/nodes/MatchAwards/MatchAwards.node.js"]
  },
  "devDependencies": {
    "n8n-workflow": "^2.16.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
